# Copy to .env and fill in. Production builds run in GitHub Actions (.github/workflows/deploy-netlify.yaml):
# set the VITE_ values as repository Variables, and NETLIFY_AUTH_TOKEN / NETLIFY_SITE_ID as repository Secrets.

# Firebase web app config (Firebase console → Project settings → Your apps). Not secret: it ships in the browser bundle.
VITE_APP_APIKEY=
VITE_APP_AUTH_DOMAIN=
VITE_APP_PROJECT_ID=
VITE_APP_STORAGE_BUCKET=
VITE_APP_MESSAGING_SENDER_ID=
VITE_APP_APP_ID=

# Site address (header logo link)
VITE_SITE_URL=https://majidev.netlify.app

# majidev-backend on Vercel; enables /admin → GitHub
VITE_API_URL=
